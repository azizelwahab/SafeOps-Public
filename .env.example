NODE_ENV=development
PORT=3000
# Comma-separated browser origins. An empty value disables cross-origin access.
CORS_ORIGINS=

# Supply your own PostgreSQL connection strings. Use separate databases.
# Development database name: safeops_dev. Integration database name: safeops_test.
# Hosted NODE_ENV=production runtimes require sslmode=verify-full in DATABASE_URL.
DATABASE_URL=
TEST_DATABASE_URL=

# Generate 32 random bytes encoded as unpadded base64url before starting.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=safeops
JWT_AUDIENCE=safeops-api
BCRYPT_ROUNDS=12
AUTH_RATE_WINDOW_MS=900000
AUTH_SIGNUP_LIMIT=10
AUTH_LOGIN_LIMIT=20
